# ─────────────────────────────────────────────────────────────
# Mobile environment schema
# Copy to .env and fill in. Only EXPO_PUBLIC_* variables reach the
# app bundle, and anything here ships inside it — never put a
# secret in this file.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────

# Where the backend lives. On a physical device this must be your
# machine's LAN IP, not localhost, and the phone must be on the
# same network. Find it with: ipconfig getifaddr en0
# Example: http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=

# Clerk frontend key (pk_test_... / pk_live_...). Safe to expose;
# must come from the same Clerk instance as CLERK_SECRET_KEY on
# the backend.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# For production, set these per EAS build profile rather than here.
