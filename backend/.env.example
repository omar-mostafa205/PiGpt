# ─────────────────────────────────────────────────────────────
# Backend environment schema
# Copy to .env and fill in. Validated on boot by src/config/env.ts —
# the process exits and prints what is wrong if a required
# variable is missing.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────

# Neon Postgres connection string, including ?sslmode=require.
# Used by the Prisma client (src/services/storage/neonStorage.ts)
# and by the Prisma CLI (prisma.config.ts).
DIRECT_URL=

# Google AI Studio key for Gemini (model: gemini-2.5-flash).
# Powers /api/solve, /api/quiz and /api/summarize.
GEMINI_API_KEY=

# Clerk backend credentials. Never referenced directly in code —
# @clerk/express reads them from the environment itself — but both
# are required, so the server refuses to start without them.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── Optional ────────────────────────────────────────────────
# Leave blank to accept the default shown in the comment.

# Port the API listens on. Default: 3000
PORT=

# "development" | "production" | "test". Default: development
# development enables Prisma query logging, verbose error details
# in responses, and a permissive CORS origin.
NODE_ENV=

# Fixed-window rate limit per client IP, held in memory.
# Note: in-process only, so it resets on deploy and is not shared
# across replicas — move to Redis before running more than one.
# Defaults: 100 requests per 60000 ms
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
